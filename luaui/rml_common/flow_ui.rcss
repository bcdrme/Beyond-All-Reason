.element {
    padding: 4dp;
    border-radius: 8dp;
    border: 4dp rgb(0, 0, 0);
    background-color: rgb(0, 0, 0);
    image-color: rgba(100%, 100%, 100%, 1%);
    decorator:
        gradient(vertical rgba(100%, 100%, 100%, 15%) rgba(0%, 0%, 0%, 15%)),
        image("/luaui/images/flowui_gl4/backgroundtile_pretransformed.png" none repeat);
}